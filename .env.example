# =============================================================================
# MILLION BARBER — Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to `server/.env`
# 2. Update placeholder values below with your actual configuration
# 3. Never commit `server/.env` or any real secrets to Git
# =============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/million_barber?schema=public"

# JSON Web Token (JWT) Authentication
# Generate a strong random key (e.g. `openssl rand -base64 32`)
JWT_SECRET="your-strong-random-jwt-secret-key-min-32-characters"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"

# Barbershop Timezone (Strictly Asia/Tashkent UTC+5 for Chust, Namangan)
TIMEZONE="Asia/Tashkent"

# Initial Administrator Account (Used during `npm run seed`)
# Note: First login will enforce a password change.
ADMIN_INITIAL_EMAIL="admin@millionbarber.uz"
ADMIN_INITIAL_PASSWORD="your_strong_admin_password_here"

# Initial Staff / Barbers Account Password (Used during `npm run seed`)
BARBER_INITIAL_PASSWORD="your_strong_barber_password_here"

